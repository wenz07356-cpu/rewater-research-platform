# 平台
PLATFORM_PORT=8080
ENVIRONMENT=local

# 模型服务
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_DEFAULT_MODEL=qwen-plus
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4.1-mini
LLM_TEMPERATURE=0.2
DEEPSEEK_API_BASE=
DEEPSEEK_API_KEY=
TAVILY_API_KEY=

# 文档解析
MINERU_BASE_URL=
MINERU_API_TOKEN=

# 本地模型宿主机路径（Windows 可填写 E:/models/...）
BGE_M3_HOST_PATH=./models/bge-m3
BGE_RERANKER_HOST_PATH=./models/bge-reranker-v2-m3

# 本地模型容器内路径
BGE_M3_PATH=/app/models/bge-m3
BGE_RERANKER_LARGE=/app/models/bge-reranker-v2-m3
BGE_DEVICE=cpu
BGE_RERANKER_DEVICE=cpu

# 外部基础设施（应用容器必须能够访问这些地址；按实际环境填写）
NO_PROXY=host.docker.internal,127.0.0.1,localhost
MILVUS_URL=
CHUNKS_COLLECTION=kb_chunks_v2
ENTITY_NAME_COLLECTION=kb_entities
ITEM_NAME_COLLECTION=kb_item_names
MONGO_URL=
MONGO_DB_NAME=kb002
MONGODB_URI=
MONGODB_DATABASE=deep_research
REDIS_URL=
CELERY_BROKER_URL=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=zhishiku
MINIO_IMG_DIR=/upload-images
MINIO_SECURE=False

# 深度研究
REPORT_MAX_SECTIONS=4
ENABLE_KNOWLEDGE_SERVICE=true
KNOWLEDGE_SERVICE_TOP_K=6
