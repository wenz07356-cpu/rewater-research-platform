# =============================================================================
# Deep Research 环境变量配置
# =============================================================================
# 使用方式：复制本文件为 .env，按需修改对应值
#   cp .env.example .env
#
# 所有字段均有默认值，未设置的项将使用代码中的默认值。
# 带 # 号注释掉的为可选配置，取消注释后填入实际值即可启用。
# =============================================================================

# ------------------------------
# 应用基础配置
# ------------------------------
APP_NAME="AI 研究报告工作台"
APP_VERSION="0.1.0"
ENVIRONMENT=local
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# ------------------------------
# 数据存储
# ------------------------------
# MongoDB 连接串
# - 使用根目录 docker-compose.yml 启动时：
#   mongodb://deepresearch:deepresearch_dev@localhost:27017/deep_research?authSource=deep_research
# - 无鉴权（本地开发）：mongodb://localhost:27017
MONGODB_URI=mongodb://deepresearch:deepresearch_dev@localhost:27017/deep_research?authSource=deep_research
MONGODB_DATABASE=deep_research
# Redis 连接串
# - 使用根目录 docker-compose.yml 启动时：
#   redis://:infini_rag_flow@localhost:6379/0
# - 如果复用其他 Redis，请同步修改密码、端口和 db 编号
REDIS_URL=redis://:infini_rag_flow@localhost:6379/0
CELERY_BROKER_URL=redis://:infini_rag_flow@localhost:6379/0

# ------------------------------
# LLM 大模型配置
# ------------------------------
# 模型提供商：openai / deepseek
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4.1-mini
LLM_TEMPERATURE=0.2
# 课堂演示建议保持较小；控制每次报告最多完整研究多少个 section
REPORT_MAX_SECTIONS=4

# OpenAI 接口（使用 OpenAI 兼容 API 时填写）
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=sk-xxxxxxxx

# DeepSeek 接口（使用 DeepSeek 时填写）
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# DEEPSEEK_API_KEY=sk-xxxxxxxx

# ------------------------------
# 自研内部知识库（推荐）
# ------------------------------
# research-service 调用 knowledge-service 查询服务的 /retrieval 接口。
# 注意：8000 是导入服务，8001 才是查询/证据检索服务。
# knowledge-service 当前未提供鉴权，只应使用本机或可信内网地址，不建议暴露到公网。
ENABLE_KNOWLEDGE_SERVICE=true
KNOWLEDGE_SERVICE_BASE_URL=http://localhost:8001
# knowledge-service 当前公开契约只允许 1～6。
KNOWLEDGE_SERVICE_TOP_K=6

# ------------------------------
# Tavily 外部搜索
# ------------------------------
# TAVILY_API_KEY=tvly-xxxxxxxx

# ------------------------------
# 对象存储（MinIO / S3 兼容）
# ------------------------------
# OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=deep-research
# OBJECT_STORAGE_ACCESS_KEY=minioadmin
# OBJECT_STORAGE_SECRET_KEY=minioadmin
